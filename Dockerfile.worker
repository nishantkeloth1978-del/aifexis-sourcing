# The internal clock for automatic steps: a tiny always-on process that runs a pass every minute. Needs DATABASE_URL.
FROM node:22-slim
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci
COPY tsconfig.json vitest.config.ts ./
COPY src ./src
COPY scripts ./scripts
CMD ["npx", "vite-node", "--config", "vitest.config.ts", "scripts/worker.ts"]
